# Copy to .env for local runs (`pnpm review:local`, `pnpm eval`). Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# A GitHub token with pull-requests:write on the target repo (for `pnpm review:local`).
GITHUB_TOKEN=ghp_...
# Set to "mock" to run everything without an API key (tests and CI use this).
LLM_PROVIDER=anthropic
